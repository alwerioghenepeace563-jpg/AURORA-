# AURORA environment template — placeholders only.
# Copy to .env for local development. Never commit real values.
# In production, configure values in the relevant Vercel project settings.

# ---------------------------------------------------------------------------
# STAGES 1–8: core assistant, chat intelligence, tools and provider fallback
# At least ONE text provider key is required. For resilience, configure all 3.
# Server-only credentials: do NOT prefix these with VITE_.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional shared provider preference across serverless instances.
# Both values are needed; without them provider preference is best-effort.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# STAGES 9–10: sign-in, user-scoped memory and authenticated API requests
# Supabase anon/publishable key is designed for client use with correct RLS.
# VITE_ values are bundled into the web/Android client; never put service-role
# keys or any other privileged secret in a VITE_ variable.
VITE_SUPABASE_URL=
# Legacy client URL alias; use the same project URL as VITE_SUPABASE_URL.
VITE_SUPABASE_API=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# GOOGLE WORKSPACE: OAuth client ID used for Calendar + Drive read-only authorisation.
# Configure the same authorised web origin in Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=

# STAGE 11: voice, creative image generation and transcription bridge
# ElevenLabs is optional; browser speech fallback can work without it.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Optional per-voice IDs if the app uses named voice choices.
ELEVENLABS_JESSICA_VOICE_ID=
ELEVENLABS_BELLA_VOICE_ID=
ELEVENLABS_LAURA_VOICE_ID=
ELEVENLABS_LUCIAN_VOICE_ID=

# Gemini image generation uses GEMINI_API_KEY above.
# VoiceText is a separate app/service. The token must match the VoiceText
# project's AURORA_PLUGIN_TOKEN. Keep both values server-side.
VOICETEXT_API_URL=https://aurora-voicetext-qk8s.vercel.app
VOICETEXT_PLUGIN_TOKEN=

# ---------------------------------------------------------------------------
# ADMIN / SERVER POLICY (optional features; server-side only)
AURORA_ALLOWED_ORIGIN=
ADMIN_EMAIL_ALLOWLIST=
AURORA_GITHUB_TOKEN=
AURORA_GITHUB_REPO=alwerioghenepeace563-jpg/AURORA-
AURORA_GITHUB_BASE_BRANCH=main

# ---------------------------------------------------------------------------
# OPTIONAL REMOTE MCP CONNECTORS — server-side only; never use VITE_ prefixes.
# Free default: Exa hosted MCP, keyless with rate limits. Disable with false if needed.
AURORA_EXA_ENABLED=true
AURORA_EXA_MCP_URL=https://mcp.exa.ai/mcp
# Firecrawl is optional and disabled unless an API key or OAuth access token is configured.
# Do not add billing; leave these blank to use the free Exa research connector instead.
AURORA_FIRECRAWL_ENABLED=false
AURORA_FIRECRAWL_MCP_URL=https://mcp.firecrawl.dev/v2/mcp
FIRECRAWL_API_KEY=
FIRECRAWL_OAUTH_TOKEN=
# Optional Cloudflare Browser Run Markdown reader (server-only).
# Workers Free currently includes 10 browser minutes/day; no paid upgrade is needed
# for this allowance. Keep usage within the free limit to avoid charges.
AURORA_CLOUDFLARE_BROWSER_ENABLED=true
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional separately hosted Playwright MCP; not required for Browser Run Markdown.
AURORA_PLAYWRIGHT_MCP_URL=
AURORA_PLAYWRIGHT_MCP_TOKEN=
# Configure Glyph only after confirming the exact MCP implementation and endpoint.
AURORA_GLYPH_MCP_URL=
AURORA_GLYPH_MCP_TOKEN=

# ---------------------------------------------------------------------------
# LOCAL / BUILD METADATA (not secrets; normally set by the build workflow)
VITE_AURORA_VERSION_CODE=
VITE_AURORA_VERSION_NAME=

# Server-only bridge retained from main; never expose this token with a VITE_ prefix.
AURORA_VOICETEXT_API_URL=https://aurora-voicetext-qk8s.vercel.app/api/aurora-transcribe
AURORA_VOICETEXT_TOKEN=
