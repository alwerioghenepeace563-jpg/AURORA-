# Template only. Add real keys in Vercel Environment Variables.
# Never commit real API keys.

# Text AI fallback order: Groq -> OpenRouter -> Gemini.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional shared provider memory across Vercel serverless instances.
# Configure both values using an Upstash Redis REST database to make provider
# failover sticky across all requests. Without these, AURORA uses best-effort
# instance-local memory (serverless instances may not share it).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ElevenLabs voice generation (separate from the text AI provider).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Optional: your exact deployed AURORA website origin
AURORA_ALLOWED_ORIGIN=

# Private GitHub release metadata/download URLs for the native Android updater.
# Create a fine-grained token with read-only Contents access to the AURORA repository.
# Add this as a server-side Vercel secret; never use a VITE_ prefix or put it in the APK.
AURORA_GITHUB_REPOSITORY=alwerioghenepeace563-jpg/AURORA-
AURORA_GITHUB_TOKEN=
