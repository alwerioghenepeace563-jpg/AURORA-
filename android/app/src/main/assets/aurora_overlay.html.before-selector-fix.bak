<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AURORA Floating Overlay</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
    
    body {
      font-family: 'Inter', sans-serif;
      background-color: #0b0f19;
      color: #e2e8f0;
    }

    /* Dynamic Glassmorphism Utility */
    .glass-panel {
      background: rgba(15, 23, 42, 0.65);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.12);
      box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
    }

    .glass-chip {
      background: rgba(30, 41, 59, 0.7);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    /* Ambient Outer Edge Glow */
    .phone-ambient-glow {
      box-shadow: 0 0 50px -5px rgba(6, 182, 212, 0.45),
                  0 0 80px 10px rgba(139, 92, 246, 0.35);
      transition: box-shadow 0.5s ease;
    }

    /* Pulsing & Glowing Orb */
    .jarvis-orb {
      background: radial-gradient(circle, rgba(167,139,250,1) 0%, rgba(6,182,212,0.9) 45%, rgba(139,92,246,0.3) 70%, rgba(0,0,0,0) 100%);
      box-shadow: 0 0 25px rgba(6, 182, 212, 0.8),
                  0 0 50px rgba(139, 92, 246, 0.6);
      animation: orbPulse 3s infinite ease-in-out;
    }

    @keyframes orbPulse {
      0%, 100% {
        transform: scale(1);
        box-shadow: 0 0 25px rgba(6, 182, 212, 0.8), 0 0 50px rgba(139, 92, 246, 0.6);
      }
      50% {
        transform: scale(1.08);
        box-shadow: 0 0 35px rgba(6, 182, 212, 0.95), 0 0 65px rgba(139, 92, 246, 0.85);
      }
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: rgba(15, 23, 42, 0.6);
    }
    ::-webkit-scrollbar-thumb {
      background: rgba(51, 65, 85, 0.8);
      border-radius: 4px;
    }
  /* AURORA floating-window adaptation; original glass styling retained */
html, body {
  width: 100% !important;
  height: 100% !important;
  min-height: 0 !important;
  margin: 0 !important;
  padding: 0 !important;
  overflow: hidden !important;
}
body { display: block !important; }
body > header { display: none !important; }
main.w-full.max-w-6xl {
  display: block !important;
  width: 100% !important;
  height: 100% !important;
  max-width: none !important;
  margin: 0 !important;
  padding: 0 !important;
}
main > section:first-child { display: none !important; }
main > section:last-child {
  display: block !important;
  width: 100% !important;
  height: 100% !important;
}
.phone-ambient-glow {
  width: 100% !important;
  height: 100% !important;
  max-width: none !important;
  border-radius: 26px !important;
  padding: 5px !important;
  border-width: 1px !important;
}
.phone-ambient-glow > div {
  width: 100% !important;
  height: 100% !important;
  border-radius: 20px !important;
  background-image: none !important;
  background: radial-gradient(ellipse at 50% 30%, #172554 0%, #0b0f19 65%, #070b14 100%) !important;
}
.aurora-prompt {
  display: block;
  width: 100%;
  min-width: 0;
  border: 0;
  outline: none;
  background: transparent;
  color: #e2e8f0;
  font: inherit;
  padding: 4px 8px;
}
.aurora-prompt::placeholder { color: #cbd5e1; opacity: 1; }
#auroraReply {
  display: none;
  width: 100%;
  max-height: 66px;
  overflow-y: auto;
  overflow-wrap: anywhere;
  white-space: pre-wrap;
  font-size: 11px;
  line-height: 1.4;
  color: #e2e8f0;
  padding: 8px 10px;
  border: 1px solid rgba(255,255,255,.12);
  border-radius: 12px;
  background: rgba(15,23,42,.78);
}

/* AURORA floating-window responsive Studio layout */
main > section:last-child {
  min-height: 0 !important;
  overflow: hidden !important;
}
.phone-ambient-glow {
  box-sizing: border-box !important;
  min-width: 0 !important;
  min-height: 0 !important;
  display: flex !important;
  flex-direction: column !important;
}
.phone-ambient-glow > div {
  box-sizing: border-box !important;
  min-height: 0 !important;
  flex: 1 1 auto !important;
  overflow: hidden !important;
}
.phone-ambient-glow > div > div:nth-child(2) {
  min-height: 0 !important;
  flex: 1 1 auto !important;
  justify-content: center !important;
  gap: 6px !important;
  margin-top: 0 !important;
  margin-bottom: 0 !important;
  overflow-y: auto !important;
  scrollbar-width: none;
}
.phone-ambient-glow > div > div:nth-child(2)::-webkit-scrollbar {
  display: none;
}
.phone-ambient-glow #weatherCard {
  flex-shrink: 1 !important;
  min-width: 0 !important;
  padding: 8px !important;
}
.phone-ambient-glow .jarvis-orb {
  flex-shrink: 0 !important;
  width: 48px !important;
  height: 48px !important;
  margin-top: 2px !important;
  margin-bottom: 2px !important;
}
.phone-ambient-glow > div > div:nth-child(3) {
  flex-shrink: 0 !important;
  padding: 8px 8px 4px !important;
}
.phone-ambient-glow #auroraReply {
  max-height: 54px !important;
}
@media (max-height: 520px) {
  .phone-ambient-glow > div > div:nth-child(2) {
    gap: 4px !important;
  }
  .phone-ambient-glow .jarvis-orb {
    width: 40px !important;
    height: 40px !important;
  }
  .phone-ambient-glow #weatherCard {
    padding: 5px !important;
  }
}
.aurora-overlay-close{position:fixed;top:8px;right:10px;z-index:99999;width:32px;height:32px;border:1px solid rgba(255,255,255,.25);border-radius:50%;background:rgba(15,23,42,.92);color:white;font-size:20px;cursor:pointer}
</style>
</head>
<body class="min-h-screen flex flex-col justify-between items-center p-4 md:p-8">

  <!-- Header -->
  <header class="w-full max-w-6xl flex justify-between items-center mb-6">
    <div class="flex items-center gap-3">
      <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-cyan-500 to-purple-600 flex items-center justify-center font-bold text-white shadow-lg">J</div>
      <div>
        <h1 class="font-bold text-lg leading-tight text-white">AURORA Overlay</h1>
        <p class="text-xs text-slate-400">Interactive UI Mockup & Code Export</p>
      </div>
    </div>
    <div class="flex items-center gap-3">
      <button onclick="toggleModal('codeModal')" class="px-4 py-2 bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white rounded-lg text-sm font-medium transition flex items-center gap-2 shadow-lg shadow-cyan-500/20">
        <i class="fa-solid fa-code"></i> Export Code
      </button>
    </div>
  </header>

  <!-- Main Grid Layout -->
  <main class="w-full max-w-6xl grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    
    <!-- Control Panel Sidebar -->
    <section class="lg:col-span-5 bg-slate-900/80 border border-slate-800 rounded-2xl p-5 backdrop-blur-md space-y-6">
      <h2 class="text-sm font-semibold tracking-wider text-slate-400 uppercase flex items-center gap-2">
        <i class="fa-solid fa-sliders text-cyan-400"></i> Interface Customizer
      </h2>

      <!-- Blur Controls -->
      <div class="space-y-2">
        <label class="text-xs font-medium text-slate-300 flex justify-between">
          <span>Background Blur Strength</span>
          <span id="blurValueLabel" class="text-cyan-400 font-mono">Medium (8px)</span>
        </label>
        <div class="grid grid-cols-4 gap-2">
          <button onclick="setBlur('0px', 'None (0px)', this)" class="blur-btn px-3 py-2 text-xs rounded-lg border border-slate-700 bg-slate-800 hover:bg-slate-700 text-slate-300 font-medium transition">None</button>
          <button onclick="setBlur('4px', 'Low (4px)', this)" class="blur-btn px-3 py-2 text-xs rounded-lg border border-slate-700 bg-slate-800 hover:bg-slate-700 text-slate-300 font-medium transition">Low</button>
          <button onclick="setBlur('8px', 'Medium (8px)', this)" class="blur-btn active-blur px-3 py-2 text-xs rounded-lg border border-cyan-500/50 bg-cyan-950/40 text-cyan-300 font-medium transition">Med</button>
          <button onclick="setBlur('16px', 'High (16px)', this)" class="blur-btn px-3 py-2 text-xs rounded-lg border border-slate-700 bg-slate-800 hover:bg-slate-700 text-slate-300 font-medium transition">High</button>
        </div>
      </div>

      <!-- Plugin Toggles -->
      <div class="space-y-2">
        <label class="text-xs font-medium text-slate-300">Active Plugin Chips</label>
        <div class="flex flex-wrap gap-2">
          <button onclick="togglePlugin('calendar')" id="chip-calendar" class="px-3 py-1.5 text-xs rounded-lg border border-cyan-500/40 bg-cyan-500/10 text-cyan-300 flex items-center gap-2 transition">
            <i class="fa-regular fa-calendar"></i> Calendar
          </button>
          <button onclick="togglePlugin('tasks')" id="chip-tasks" class="px-3 py-1.5 text-xs rounded-lg border border-purple-500/40 bg-purple-500/10 text-purple-300 flex items-center gap-2 transition">
            <i class="fa-solid fa-list-check"></i> Tasks
          </button>
          <button onclick="togglePlugin('email')" id="chip-email" class="px-3 py-1.5 text-xs rounded-lg border border-blue-500/40 bg-blue-500/10 text-blue-300 flex items-center gap-2 transition">
            <i class="fa-regular fa-envelope"></i> Email
          </button>
        </div>
      </div>

      <!-- Weather Card Preset -->
      <div class="space-y-2">
        <label class="text-xs font-medium text-slate-300">Response Card Widget</label>
        <div class="flex items-center justify-between p-3 rounded-xl border border-slate-800 bg-slate-900">
          <div class="flex items-center gap-3">
            <i class="fa-solid fa-sun text-amber-400 text-lg"></i>
            <div>
              <p class="text-xs font-semibold text-slate-200">72°F, Sunny</p>
              <p class="text-[10px] text-slate-400">Los Angeles, CA</p>
            </div>
          </div>
          <button onclick="toggleWeatherCard()" id="weatherToggleBtn" class="text-xs px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700">Hide</button>
        </div>
      </div>

      <!-- Quick Prompt Simulator -->
      <div class="space-y-2">
        <label class="text-xs font-medium text-slate-300">Simulate Input</label>
        <div class="flex gap-2">
          <input type="text" id="simInput" placeholder="Type prompt..." value="What's my schedule for today?" class="w-full px-3 py-2 text-xs bg-slate-900 border border-slate-700 rounded-lg text-slate-200 focus:outline-none focus:border-cyan-500">
          <button onclick="sendPrompt()" class="px-4 py-2 text-xs bg-cyan-600 hover:bg-cyan-500 text-white font-semibold rounded-lg transition">Send</button>
        </div>
      </div>
    </section>

    <!-- Smartphone Frame Simulation -->
    <section class="lg:col-span-7 flex justify-center">
      <div class="relative w-[360px] h-[740px] rounded-[48px] p-3 bg-slate-950 border-4 border-slate-800 phone-ambient-glow overflow-hidden select-none">
        
        <!-- Dynamic Phone Display Screen -->
        <div class="relative w-full h-full rounded-[38px] overflow-hidden flex flex-col justify-between bg-cover bg-center" style="background: radial-gradient(ellipse at 50% 30%, #172554 0%, #0b0f19 65%, #070b14 100%);">
          
          <!-- Background Blur Layer -->
          <div id="bgBlurLayer" class="absolute inset-0 transition-all duration-300" style="backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); background: rgba(11, 15, 25, 0.45);"></div>

          <!-- Top Status Bar -->
          <div class="relative z-10 pt-3 px-6 flex justify-between items-center text-xs text-white font-medium">
            <span>9:41</span>
            <!-- Dynamic Island / Notch -->
            <div class="w-24 h-5 bg-black rounded-full flex items-center justify-center">
              <div class="w-2.5 h-2.5 bg-slate-900 rounded-full border border-slate-800"></div>
            </div>
            <div class="flex items-center gap-1.5 text-xs">
              <i class="fa-solid fa-signal"></i>
              <i class="fa-solid fa-wifi"></i>
              <i class="fa-solid fa-battery-full"></i>
            </div>
          </div>


          <!-- Center Content Area: Glass Cards & Orb -->
          <div class="relative z-20 px-4 space-y-3 mt-auto mb-2 flex flex-col items-center">
            
            <div id="auroraReply" role="status" aria-live="polite"></div>
            <!-- Weather Card -->
            <div id="weatherCard" class="glass-panel w-full p-3 rounded-2xl flex items-center justify-between text-white transition-all">
              <div class="flex items-center gap-3">
                <i class="fa-solid fa-cloud-sun text-amber-300 text-2xl"></i>
                <div>
                  <p class="text-xs font-semibold">72°F, Sunny</p>
                  <p class="text-[10px] text-slate-300">Sunny, Los Angeles</p>
                </div>
              </div>
              <span class="text-[10px] px-2 py-0.5 rounded-full bg-white/10 border border-white/10">AURORA Weather</span>
            </div>

            <!-- Plugin Chips Row -->
            <div class="w-full flex justify-start gap-2 overflow-x-auto py-1">
              <div id="chip-calendar-ui" class="glass-chip px-3 py-1 rounded-full text-[11px] text-cyan-300 border border-cyan-400/30 flex items-center gap-1.5 shadow-sm">
                <i class="fa-regular fa-calendar"></i> Calendar
              </div>
              <div id="chip-tasks-ui" class="glass-chip px-3 py-1 rounded-full text-[11px] text-purple-300 border border-purple-400/30 flex items-center gap-1.5 shadow-sm">
                <i class="fa-solid fa-list-check"></i> Tasks
              </div>
              <div id="chip-email-ui" class="glass-chip px-3 py-1 rounded-full text-[11px] text-blue-300 border border-blue-400/30 flex items-center gap-1.5 shadow-sm">
                <i class="fa-regular fa-envelope"></i> Email
              </div>
            </div>

            <!-- Floating JARVIS Holographic Orb -->
            <div class="w-16 h-16 rounded-full jarvis-orb flex items-center justify-center my-1 cursor-pointer transition transform hover:scale-110" onclick="triggerOrbPulse()">
              <div class="w-6 h-6 rounded-full bg-white/80 blur-[2px]"></div>
            </div>

          </div>

          <!-- Bottom JARVIS Glass Dock -->
          <div class="relative z-20 p-3 pt-0">
            <div class="glass-panel p-2.5 rounded-3xl flex flex-col gap-2">
              <input type="text" id="promptDisplay" class="aurora-prompt" placeholder="Ask AURORA..." aria-label="Ask AURORA" autocomplete="off">
              
              <!-- Input Action Bar -->
              <div class="flex items-center justify-between text-slate-300 pt-1 border-t border-white/10 text-xs">
                <div class="flex items-center gap-3 px-1">
                  <button class="hover:text-cyan-400 transition"><i class="fa-solid fa-plus"></i></button>
                  <button class="hover:text-cyan-400 transition"><i class="fa-solid fa-paperclip"></i></button>
                  <button class="hover:text-cyan-400 transition"><i class="fa-solid fa-cubes"></i></button>
                </div>
                <div class="flex items-center gap-2">
                  <button class="w-7 h-7 rounded-full bg-slate-800/80 border border-white/10 flex items-center justify-center hover:text-cyan-400 transition">
                    <i class="fa-solid fa-microphone"></i>
                  </button>
                  <button id="auroraSend" type="button" onclick="sendOverlayPrompt()" class="w-7 h-7 rounded-full bg-gradient-to-r from-cyan-500 to-purple-600 text-white flex items-center justify-center shadow-md">
                    <i class="fa-solid fa-paper-plane text-[10px]"></i>
                  </button>
                </div>
              </div>
            </div>
            
            <!-- Home Indicator -->
            <div class="w-32 h-1 bg-white/40 rounded-full mx-auto mt-2"></div>
          </div>

        </div>
      </div>
    </section>

  </main>

  <!-- Modal Code Export -->
  <div id="codeModal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-3xl max-h-[85vh] flex flex-col overflow-hidden shadow-2xl">
      <div class="p-4 border-b border-slate-800 flex justify-between items-center">
        <h3 class="font-semibold text-slate-200 text-sm flex items-center gap-2">
          <i class="fa-solid fa-code text-cyan-400"></i> Integration Code Output
        </h3>
        <button onclick="toggleModal('codeModal')" class="text-slate-400 hover:text-white text-lg">&times;</button>
      </div>
      
      <div class="p-4 overflow-y-auto space-y-4">
        <!-- React Native Tab -->
        <div>
          <h4 class="text-xs font-semibold text-cyan-400 uppercase tracking-wider mb-2">React Native Overlay Component</h4>
          <pre class="bg-slate-950 p-3 rounded-lg text-xs font-mono text-slate-300 overflow-x-auto border border-slate-800">
import React from 'react';
import { View, Text, StyleSheet, TextInput, TouchableOpacity } from 'react-native';
import { BlurView } from '@react-native-community/blur';

export const JarvisOverlay = ({ blurAmount = 8 }) => {
  return (
    &lt;View style={StyleSheet.absoluteFillObject}&gt;
      {/* Dynamic Background Blur */}
      &lt;BlurView
        style={StyleSheet.absoluteFillObject}
        blurType="dark"
        blurAmount={blurAmount}
        reducedTransparencyFallbackColor="black"
      /&gt;
      
      {/* Assistant Bottom Container */}
      &lt;View style={styles.bottomDock}&gt;
        &lt;TextInput 
          placeholder="Ask AURORA..." 
          placeholderTextColor="#94a3b8" 
          style={styles.input} 
        /&gt;
      &lt;/View&gt;
    &lt;/View&gt;
  );
};

const styles = StyleSheet.create({
  bottomDock: {
    position: 'absolute',
    bottom: 30,
    left: 20,
    right: 20,
    backgroundColor: 'rgba(15, 23, 42, 0.7)',
    borderRadius: 24,
    padding: 16,
    borderWidth: 1,
    borderColor: 'rgba(255, 255, 255, 0.15)',
  },
  input: {
    color: '#ffffff',
    fontSize: 14,
  }
});
          </pre>
        </div>
      </div>

      <div class="p-3 border-t border-slate-800 bg-slate-950 flex justify-end">
        <button onclick="toggleModal('codeModal')" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-lg text-xs font-medium">Close</button>
      </div>
    </div>
  </div>

  <!-- JavaScript Interactivity -->
  <script>
    // Blur strength control
    function setBlur(blurPx, label, btnElement) {
      const bgLayer = document.getElementById('bgBlurLayer');
      bgLayer.style.backdropFilter = `blur(${blurPx})`;
      bgLayer.style.webkitBackdropFilter = `blur(${blurPx})`;
      
      // Update backdrop opacity for 0px blur
      if (blurPx === '0px') {
        bgLayer.style.background = 'rgba(11, 15, 25, 0.15)';
      } else {
        bgLayer.style.background = 'rgba(11, 15, 25, 0.45)';
      }

      document.getElementById('blurValueLabel').innerText = label;

      // Update active button state
      document.querySelectorAll('.blur-btn').forEach(btn => {
        btn.classList.remove('border-cyan-500/50', 'bg-cyan-950/40', 'text-cyan-300');
        btn.classList.add('border-slate-700', 'bg-slate-800', 'text-slate-300');
      });
      btnElement.classList.remove('border-slate-700', 'bg-slate-800', 'text-slate-300');
      btnElement.classList.add('border-cyan-500/50', 'bg-cyan-950/40', 'text-cyan-300');
    }

    // Toggle plugin chips
    function togglePlugin(type) {
      const chipUi = document.getElementById(`chip-${type}-ui`);
      const chipBtn = document.getElementById(`chip-${type}`);
      if (chipUi.style.display === 'none') {
        chipUi.style.display = 'flex';
        chipBtn.classList.remove('opacity-40');
      } else {
        chipUi.style.display = 'none';
        chipBtn.classList.add('opacity-40');
      }
    }

    // Toggle weather widget
    function toggleWeatherCard() {
      const card = document.getElementById('weatherCard');
      const btn = document.getElementById('weatherToggleBtn');
      if (card.style.display === 'none') {
        card.style.display = 'flex';
        btn.innerText = 'Hide';
      } else {
        card.style.display = 'none';
        btn.innerText = 'Show';
      }
    }

    // Prompt simulation
    function sendPrompt() {
      const input = document.getElementById('simInput');
      const display = document.getElementById('promptDisplay');
      if (input.value.trim() !== '') {
        display.innerText = input.value;
        triggerOrbPulse();
      }
    }

    // Orb visual trigger
    function triggerOrbPulse() {
      const orb = document.querySelector('.jarvis-orb');
      orb.style.transform = 'scale(1.25)';
      setTimeout(() => {
        orb.style.transform = 'scale(1)';
      }, 300);
    }

    async function sendOverlayPrompt() {
      const input = document.getElementById('promptDisplay');
      const button = document.getElementById('auroraSend');
      const reply = document.getElementById('auroraReply');
      const text = input.value.trim();

      if (!text || button.disabled) return;

      button.disabled = true;
      reply.style.display = 'block';
      reply.textContent = 'AURORA is thinking…';

      try {
        const response = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            messages: [{ role: 'user', content: text }],
            profile: {},
            toolContext: ''
          })
        });

        const raw = await response.text();
        let data = {};
        try { data = raw ? JSON.parse(raw) : {}; } catch {}

        if (!response.ok) {
          throw new Error(data.error || ('Chat API HTTP ' + response.status));
        }

        const answer = String(data.reply || '').trim();
        if (!answer) throw new Error('AURORA returned an empty response.');

        reply.textContent = answer;
        input.value = '';
      } catch (error) {
        reply.textContent = error.message || 'Could not reach AURORA AI.';
      } finally {
        button.disabled = false;
        input.focus();
      }
    }

    document.getElementById('promptDisplay').addEventListener('keydown', event => {
      if (event.key === 'Enter') {
        event.preventDefault();
        sendOverlayPrompt();
      }
    });
    // Modal Manager
    function toggleModal(id) {
      const modal = document.getElementById(id);
      modal.classList.toggle('hidden');
    }
  function closeAuroraOverlay(){if(window.AuroraOverlay&&typeof window.AuroraOverlay.dismiss==='function'){window.AuroraOverlay.dismiss()}else{console.warn('AURORA native close bridge unavailable')}}
</script>
<button class="aurora-overlay-close" type="button" aria-label="Close AURORA overlay" onclick="closeAuroraOverlay()">×</button>
</body>
</html>

