{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aurora-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-19",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "AURORA_BACKEND_STAGE": "stage-7-release-validation"
  },
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/*"
    ]
  }
}