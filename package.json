{
  "name": "aurora-assistant",
  "version": "0.2.0",
  "private": true,
  "description": "AURORA personal AI assistant for web and Android",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "android:sync": "npm run build && npm run android:check && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:check": "node scripts/check-android-feature-parity.mjs"
  },
  "dependencies": {
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/app": "^7.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@vitejs/plugin-react": "^4.7.0",
    "@vercel/node": "^5.3.0",
    "typescript": "^5.8.3",
    "vite": "^6.4.1",
    "@capacitor/cli": "^7.4.3"
  },
  "type": "module"
}
